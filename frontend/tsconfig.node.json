{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // eslint.config.mjs is `@ts-check`ed and must belong to a project for
    // eslint's own type-aware rules to resolve it.
    "allowJs": true
  },
  "include": [
    "eslint.config.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "postcss.config.ts",
    "tailwind.config.ts"
  ]
}
