# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
venv/
.venv/

# Tool caches. Also keeps them away from prettier, which defaults its
# --ignore-path to [.gitignore, .prettierignore]: .pytest_cache ships a
# README.md, so an unignored cache made `npm run format:check` fail after
# every test run.
.pytest_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/

# TypeScript/Vitest build artifacts (compiled config + incremental build info)
*.tsbuildinfo
vite.config.d.ts
vite.config.js
vitest.config.d.ts
vitest.config.js

# Environment
.env
.env.local
.env.production

# IDE
.vscode/
.idea/

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Database
*.db

# Database dumps — may contain production data; never commit
*.sql
!backend/alembic/**/*.sql

# Logs
*.log

# claude
.claude
