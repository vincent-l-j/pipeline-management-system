{
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-yaml": "1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "scripts": {
    "format": "npm run format:prettier && npm run format:ruff",
    "format:check": "npm run format:prettier:check && npm run format:ruff:check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "format:ruff": "ruff format backend/",
    "format:ruff:check": "ruff format --check backend/",
    "lint:frontend": "eslint frontend/src/",
    "lint:backend": "ruff check backend/",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:fix": "eslint --fix frontend/src/ && ruff check --fix backend/"
  }
}
