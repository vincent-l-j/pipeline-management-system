# ===========================================
# Rozetta PMS — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.
#
# This file configures the LOCAL dev stack (docker-compose.yml). Production runs
# on DigitalOcean App Platform, where these values are set in `.do/app.yaml` and
# the DO control panel (secrets), and DATABASE_URL is injected by the managed
# Postgres database — not from a .env file.

# --- Database ---
POSTGRES_USER=rozetta
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=rozetta_pms
DATABASE_URL=postgresql://rozetta:change_me_to_a_strong_password@db:5432/rozetta_pms

# --- Backend ---
# REQUIRED — the app refuses to start if unset (no default). e.g. `openssl rand -hex 32`
SECRET_KEY=change_me_to_a_random_string
BACKEND_CORS_ORIGINS=http://localhost:5173
# Public origin of the app (local dev default shown).
FRONTEND_URL=http://localhost:5173

# Emails granted ADMIN automatically on first Microsoft sign-in (comma-separated).
ADMIN_EMAILS=

# Dev-only test login (the "Dev Login (Admin)" button). MUST be false in production.
ENABLE_DEV_LOGIN=false

# --- Observability ---
# Root log level; set to DEBUG to see per-request detail.
LOG_LEVEL=INFO
# Tags every JSON log record so records from different deployments are distinguishable.
ENVIRONMENT=development
# Release marker reported by /api/health/ready. Hand-bumped, NOT a git SHA — App
# Platform exposes no bindable commit hash, so each environment sets its own value.
APP_VERSION=dev

# --- Microsoft Azure AD OAuth ---
# Get these from Azure Portal > App registrations
AZURE_CLIENT_ID=your-azure-client-id
# REQUIRED — the app refuses to start if unset (no default).
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
# Must EXACTLY match the redirect URI registered in Azure.
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Object store (pitch attachments) ---
# Leave these empty and attachments simply do not work — every upload is refused
# with "the document store is not configured" and the rest of the app is
# unaffected. Nothing else here depends on them.
#
# To work on attachments locally, fill the keys below in and start the stack with
# the object-store profile, which runs MinIO as a sibling container:
#
#     docker compose --profile objectstore up
#
# The devcontainer needs no flag: devcontainer.json names `minio` and
# `minio-bucket` in `runServices`, and naming a profiled service is what enables
# its profile where there is no Docker socket to pass one to.
#
# MinIO speaks the same S3 API and checks the signature, so this exercises the
# real request path. The bucket is created for you; browse it at
# http://localhost:9001 with the key id and secret as the login. The values it
# expects are docker-compose.yml's own defaults, so changing one means changing
# both — written without `=` so there is no second assignment to accidentally
# uncomment underneath the real one:
#
#     SPACES_REGION             syd1
#     SPACES_BUCKET             rozetta-pms-local
#     SPACES_ROOT_PREFIX        pitches
#     SPACES_ACCESS_KEY_ID      rozettalocal
#     SPACES_SECRET_ACCESS_KEY  change_me_to_a_strong_password
#     SPACES_ENDPOINT           http://minio:9000
#
# Against a real Space instead, leave SPACES_ENDPOINT empty — it is then built
# from the region, which is what the deployed specs rely on — and use a key pair
# from the DO control panel: API > Spaces Keys. That is not a DO API token and
# not an AWS key, and it should be scoped to the one Space. Note the devcontainer
# has no route to the internet, so a real Space is unreachable from it — that is
# what MinIO is for.
SPACES_REGION=
SPACES_BUCKET=
SPACES_ROOT_PREFIX=pitches
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_ENDPOINT=

# --- Claude API (optional — enables AI Notetaker) ---
# ANTHROPIC_API_KEY=your-claude-api-key

# --- SOP Configuration (for db-bootstrap.md and db-change.md) ---
# Health check endpoint (used to verify app is healthy after migrations)
LOCAL_HEALTH_URL=http://localhost:8000/api/health
# Readiness endpoint (also checks the database is reachable)
LOCAL_READY_URL=http://localhost:8000/api/health/ready
# Test directory path (where migration tests live)
TESTS_DIR=backend/tests/
# Table that was changed in a migration (filled in per db-change.md step 4)
TABLE_CHANGED=
# Throwaway databases used during bootstrap (create/drop as needed during db-bootstrap.md)
GENESIS_DB=genesis
CREATEALL_DB=createall
