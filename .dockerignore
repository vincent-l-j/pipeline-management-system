# Applies only to the `app` dev container, the one build whose context is the
# repo root. backend/ and frontend/ have their own contexts and ignore files.
#
# Without this the daemon receives the whole repo on every build. The image needs
# .devcontainer/ and the requirements files; everything else arrives via the bind
# mount at runtime.

.git
.github

node_modules
**/node_modules

**/venv
**/.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache

# Secrets never belong in a build context; .env is read at runtime from the mount.
.env
.env.*
!.env.example

dist
build
frontend/dist
.DS_Store
**/.DS_Store
